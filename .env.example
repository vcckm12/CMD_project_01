# Copy with: python scripts/gen_env.py   (fills every *_PASSWORD with random values)
# Never commit .env. Values marked CHANGE_ME are placeholders only.
COMPOSE_PROJECT_NAME=ag_prod
APP_ENV=production

# PostgreSQL 17
AG_DB_NAME=ai_guardrail
POSTGRES_PASSWORD=CHANGE_ME
AG_OWNER_PASSWORD=CHANGE_ME
AG_AUTH_PASSWORD=CHANGE_ME
AG_CHAT_PASSWORD=CHANGE_ME
AG_RULES_PASSWORD=CHANGE_ME
AG_AUDIT_READER_PASSWORD=CHANGE_ME
AG_AUDIT_WORKER_PASSWORD=CHANGE_ME
AG_MAINTENANCE_PASSWORD=CHANGE_ME
AG_RETENTION_PASSWORD=CHANGE_ME

# Shared Ollama server (D-14, D-15)
OLLAMA_BASE_URL=http://10.10.70.65:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_DIGEST=500a1f067a9f782620b40bee6f7b0c89e17ae61f686b92c24933e4ca4b2b8b41

# Keyed fingerprints for ops alerts (D-26); keep stable and secret
INPUT_FINGERPRINT_KEY=CHANGE_ME

# Edge (D-23 stage 1): private CA certs from scripts/gen_certs.py, hosts-file names on client PCs
SHOP_HOST=shop.example.internal
OPS_HOST=ops.example.internal
OPS_ALLOW_CIDR=10.10.70.0/24
SHOP_ORIGIN=https://shop.example.internal
OPS_ORIGIN=https://ops.example.internal
HTTPS_PORT=443
