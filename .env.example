# AI Security Guardrail Chatbot - Environment Template
# Copy this file to .env and adjust values for local development.

# Application Configuration
PROJECT_NAME="AI Security Guardrail Chatbot"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
BACKEND_PORT=8000
ADMIN_UI_PORT=8501
NGINX_PORT=80

# Security Settings
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
MAX_INPUT_LENGTH=2000
MAX_OUTPUT_LENGTH=4000
ENABLE_HOT_RELOAD=true

# PostgreSQL Database Configuration
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="guardrail_admin"
POSTGRES_PASSWORD="change_me_securely"
POSTGRES_DB="guardrail_db"
DATABASE_URL="postgresql+asyncpg://guardrail_admin:change_me_securely@postgres:5432/guardrail_db"

# AI SLM & Runtime Configuration
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen2.5:latest"
OLLAMA_TIMEOUT_SECONDS=15
ENABLE_MOCK_FALLBACK=true

# Logging
LOG_LEVEL="INFO"
